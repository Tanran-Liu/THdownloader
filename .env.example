# Copy this file to .env and fill in the real credentials
# Database credentials
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USERNAME=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=thcpn

# Optional overrides for ORM style config (defaults to the MYSQL_* values above)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Alibaba Cloud OSS configuration
OSS_ENDPOINTURI=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESSKEYID=your-oss-access-key-id
OSS_ACCESSKEYSECRET=your-oss-secret
OSS_BUCKET=your-oss-bucket-name
